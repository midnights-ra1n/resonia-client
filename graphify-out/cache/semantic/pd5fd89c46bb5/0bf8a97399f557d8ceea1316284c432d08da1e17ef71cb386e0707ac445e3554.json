{"nodes": [{"id": "clinerules_03_known_gotchas_network_reconnect_ban", "label": "Ban on automatic network-reconnection logic in the player", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly removed at maintainer's request \u2014 was a source of bugs (playback jumping backward on tab focus/wake); never reintroduce retry-on-offline/online, reconnection timers, or visibilitychange-triggered stream restarts."}, {"id": "clinerules_03_known_gotchas_crossorigin_requirement", "label": "audio.crossOrigin = \"anonymous\" requirement", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory on any <audio> element connected to an AudioContext via createMediaElementSource. Without it, output is total silence (browser security measure) even though the stream appears to play (readyState=4, 'playing' event fires). Navidrome sends Access-Control-Allow-Origin:* by default; check this attribute before suspecting server/proxy."}, {"id": "clinerules_03_known_gotchas_aac_padding_silence", "label": "AAC transcoding silent padding (skip_samples not exposed by browser APIs)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ffmpeg-side AAC transcoding on Navidrome introduces silent padding undetectable via metadata in-browser; skip_samples read by native players like MPV is not exposed by decodeAudioData or <audio>. Amplitude-threshold detection (detectEdgeSilence) is an approximation, a technical browser ceiling, not a bug to keep iterating on without a new concrete lead."}, {"id": "clinerules_03_known_gotchas_mpv_gapless_desktop", "label": "True byte-perfect gapless via native MPV player (desktop-only, future)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decided: true gapless only achievable via a native player (MPV), reserved for the Tauri desktop client only via a future MPV sidecar process; not yet implemented. Do not try to reproduce perfect gapless on web beyond the existing heuristic."}, {"id": "clinerules_03_known_gotchas_native_event_trigger_rule", "label": "Gapless transition must be triggered by a native audio event, never setTimeout", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use AudioBufferSourceNode onended or an AudioContext-clock-timed silent buffer (nextTrigger) instead of setTimeout \u2014 browsers heavily throttle timers in background tabs, causing playback jump/lag on tab refocus."}, {"id": "clinerules_03_known_gotchas_instant_playback_rule", "label": "Playback must start instantly on user click (native mode), never wait for full decode", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full decode (buffer mode) is reserved for the next queued track, preloaded seconds ahead (PRELOAD_LEAD_SECONDS). Mixing the two (decoding everything before playing, including the first click) previously caused a known ~5s startup performance regression."}, {"id": "clinerules_03_known_gotchas_hmr_audio_issue", "label": "Vite HMR incompatible with the audio engine \u2014 always full page reload (F5)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMR can leave a stale AudioContext or old event listeners active alongside new ones after editing instantGaplessEngine.ts or playerStore.ts, causing phantom bugs (missing sound, or two tracks playing at once) that don't occur in real usage."}, {"id": "clinerules_03_known_gotchas_cache_storage_keys", "label": "Synthetic Cache Storage keys (https://resonia.local/audio-cache/<trackId>:<qualityId>)", "file_type": "concept", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "clinerules_03_known_gotchas_lru_metadata_storage", "label": "LRU metadata stored separately (resonia:audioCache:meta) from Cache Storage", "file_type": "concept", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "clinerules_03_known_gotchas_max_bytes_todo", "label": "DEFAULT_MAX_BYTES (500MB hardcoded cache ceiling, not yet configurable)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known TODO, not an oversight to silently fix \u2014 not yet exposed in Settings, don't treat as a bug unless explicitly requested."}, {"id": "clinerules_03_known_gotchas_nohref_rule", "label": "Never use <a href> for internal navigation (breaks SPA routing)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always use Link/NavLink from react-router-dom instead; <a href> forces a full page reload."}, {"id": "clinerules_03_known_gotchas_docs_paused", "label": "Formal documentation (docs/, CONTRIBUTING.md, ADRs) intentionally paused", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maintainer paused formal docs to focus on development; will be addressed in a separate discussion \u2014 do not generate formal doc files unprompted."}, {"id": "clinerules_03_known_gotchas_navidrome_native_api", "label": "Navidrome native API (non-Subsonic, e.g. playlist cover upload)", "file_type": "concept", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_lib_security_passwordvault", "label": "passwordVault.ts (stored password encryption)", "file_type": "code", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_client_src_lib_navidrome_nativeapi", "label": "nativeApi.ts (Navidrome native API client)", "file_type": "code", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "clinerules_03_known_gotchas_xnd_auth_header", "label": "x-nd-authorization header requirement (not standard Authorization)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard Authorization: Bearer <token>, even with a valid JWT, returns 401 'Not authenticated' \u2014 confirmed via curl outside the browser, ruling out CORS/proxy causes. Native protected requests must use x-nd-authorization: Bearer <token> instead."}, {"id": "clinerules_03_known_gotchas_playlist_image_upload", "label": "Playlist cover upload endpoint (POST /api/playlist/{id}/image, field 'image')", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be POST (not PUT/PATCH), multipart/form-data with field named exactly 'image' (not imageFile/file/artwork)."}, {"id": "clinerules_03_known_gotchas_endpoint_discovery_method", "label": "Method to discover unknown native Navidrome endpoints (inspect DevTools on Navidrome web UI)", "file_type": "rationale", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More reliable than guessing from public docs, which don't detail these internal routes."}, {"id": "clinerules_03_known_gotchas_getcoverart_playlist", "label": "getCoverArt with pl-<playlistId> id (playlist cover read via standard Subsonic endpoint)", "file_type": "concept", "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "clinerules_03_known_gotchas_network_reconnect_ban", "target": "apps_client_src_lib_audio_instantgaplessengine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "weight": 1.0}, {"source": "clinerules_03_known_gotchas_crossorigin_requirement", "target": "apps_client_src_lib_audio_instantgaplessengine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "weight": 1.0}, {"source": "clinerules_03_known_gotchas_crossorigin_requirement", "target": "clinerules_01_project_overview_navidrome", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".clinerules/03-known-gotchas.md", "source_location": null, "weight": 1.0}, {"source": "clinerules_03_known_gotchas_aac_padding_silence", "target": "apps_client_src_lib_audio_trimsilence", "relatio