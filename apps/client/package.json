{
  "name": "@resonia/client",
  "private": true,
  "version": "1.0.0-beta.5",
  "description": "Resonia — client Spotify-like pour Navidrome / OpenSubsonic",
  "author": {
    "name": "midnights-ra1n",
    "email": "midnights-ra1n@users.noreply.github.com"
  },
  "homepage": "https://github.com/midnights-ra1n/resonia-client",
  "desktopName": "resonia.desktop",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "electron:package": "electron-vite build && electron-builder --dir",
    "electron:dist": "electron-vite build && electron-builder --publish never",
    "electron:dist:mac": "electron-vite build && electron-builder --publish never --mac --arm64",
    "electron:dist:win": "electron-vite build && electron-builder --publish never --win --x64 --arm64",
    "electron:dist:linux": "electron-vite build && electron-builder --publish never --linux"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/google-sans": "^5.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/reddit-sans": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@lox-audioserver/node-airplay-sender": "^0.4.10",
    "@material-symbols/svg-400": "^0.47.6",
    "@resonia/api-client": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  }
}
